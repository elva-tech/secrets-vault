# Dev only: Vite proxy target (default http://127.0.0.1:4000)
# VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# Production (Vercel): prefer same-origin /api via root vercel.json rewrite — do NOT set VITE_API_BASE_URL.
# Only if you must call Render directly, set VITE_API_BASE_URL and on Render set SESSION_COOKIE_SAMESITE=none.
# VITE_API_BASE_URL=https://your-service.onrender.com
