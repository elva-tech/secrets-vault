# Application
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Standalone: build web and set SERVE_WEB=true so the API serves the SPA on PORT (single process).
# SERVE_WEB=true

# Multi-tenant hostname (platform = bare base domain; tenants = {slug}.{VAULT_BASE_DOMAIN})
VAULT_BASE_DOMAIN=vault.localhost

# Database (include database name for Atlas, e.g. ...mongodb.net/secrets_vault?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/secrets_vault
# Optional: fix Atlas querySrv ECONNREFUSED on Windows (comma-separated)
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Sessions (generate a strong random value for production)
SESSION_SECRET=change-me-to-a-long-random-string

# Encryption (development = local master key; production = kms)
ENCRYPTION_PROVIDER=development
# Required when ENCRYPTION_PROVIDER=development (32-byte key, base64)
VAULT_ENCRYPTION_MASTER_KEY=
# Required when ENCRYPTION_PROVIDER=kms
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=

# Object storage (local = filesystem; production = s3-compatible)
OBJECT_STORAGE_PROVIDER=local
VAULT_FILE_STORAGE_PATH=./data/vault-files
VAULT_MAX_FILE_BYTES=10485760
# Required when OBJECT_STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_ENDPOINT=

# Optional queue (MongoDB job worker is used by default)
REDIS_URL=
JOB_WORKER_INTERVAL_MS=15000

# Notifications (email provider abstraction — optional in dev)
# EMAIL_FROM=noreply@example.com

# Bootstrap platform super admin (development only)
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
# Minimum 12 characters
SEED_SUPER_ADMIN_PASSWORD=change-me-strong-password

# Session lifetime in seconds (default 8 hours)
SESSION_TTL_SECONDS=28800

# Phase 4 — OTP and temporary access grants
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
ACCESS_GRANT_DEFAULT_MINUTES=60
