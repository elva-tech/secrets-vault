# Application (mirror of repo-root .env.example — copy to backend/.env for Render or local API-only runs)
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Production split deploy (Vercel + Render): https://vault.yourdomain.com

# Optional: serve built frontend from ../frontend/dist (local combined run only).
# Do NOT set on Render when the UI is on Vercel — leave unset/false.
# SERVE_WEB=true

VAULT_BASE_DOMAIN=vault.localhost

MONGODB_URI=mongodb://127.0.0.1:27017/secrets_vault

SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ENCRYPTION_PROVIDER=development
VAULT_ENCRYPTION_MASTER_KEY=
OBJECT_STORAGE_PROVIDER=local
# cloudinary | s3 | local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
VAULT_FILE_STORAGE_PATH=./data/vault-files
VAULT_MAX_FILE_BYTES=10485760

# Notifications: log (dev/test) | elva_notify (production transactional email)
NOTIFICATION_PROVIDER=log
# ELVA_NOTIFY_API_BASE=https://api.notify.elvatech.in
# ELVA_NOTIFY_APP_ID=
# ELVA_NOTIFY_API_KEY=
# ELVA_NOTIFY_BRAND_ID=
# ELVA_NOTIFY_TIMEOUT_MS=15000

REDIS_URL=
JOB_WORKER_INTERVAL_MS=15000

SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-strong-password

SESSION_TTL_SECONDS=28800
# Required when UI and API are on different sites (Vercel frontend + Render API)
SESSION_COOKIE_SAMESITE=none

ACCESS_GRANT_DEFAULT_MINUTES=60
